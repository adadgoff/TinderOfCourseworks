{
    "name": "pg-read-sink",
    "config": {
      "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
      "tasks.max": "1",
      "connection.url": "jdbc:postgresql://readdb:5432/readdb",
      "connection.user": "user",
      "connection.password": "password",
      "topics": "pgwrite.public.users",
      "insert.mode": "upsert",
      "pk.mode": "record_value",
      "pk.fields": "id",
      "auto.create": "true",
      "auto.evolve": "true"
    }
}